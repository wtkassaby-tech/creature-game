option ServerOutput = "generated/Server.luau"
option ClientOutput = "generated/Client.luau"
option Typescript = false
option Casing = Pascal

-- Every message between a player's device and the server lives in this one schema.
-- The device only ever sends what the player chose; the server answers with results.
-- Call = SingleAsync everywhere: one listener, and the handler may yield safely.

enum BattleKind = { Wild, Tamer, Rival, Friendly }
enum ActionKind = { Move, Switch, Run }
enum EventKind = { Move, FollowUp, Switch, Faint, Item }
enum BodyPlan = { Quad, Biped, Winged, Serpent }
enum Element = { Leaf, Sand, Water, Toxic, Frost, Crystal, Fire, Storm, Arcane, Cosmic }
enum Rarity = { Common, Uncommon, Gem, Ruby, Diamond, Cosmic }

-- What the screen needs to draw one creature in a battle and show its bars.
struct BattleCreature {
	Id: string(1..40),
	BodyPlan: BodyPlan,
	Head: string(1..24),
	Torso: string(1..24),
	FrontLimbs: string(1..24),
	Legs: string(1..24),
	Tail: string(1..24),
	Colour: string(1..24),
	Size: f32,
	Rarity: Rarity,
	Element: Element,
	Level: u8,
	MaxHp: u16,
	Hp: u16,
	-- The player's own creatures list their moves; an opponent's list is empty until seen.
	Moves: string(1..24)[0..4],
}

-- One thing that happened in a turn, in the order it happened.
struct BattleEvent {
	Side: u8(1..2),
	Kind: EventKind,
	Move: string(1..24)?,
	Damage: u16,
	TargetHp: u16,
	Slot: u8(0..6),
}

-- Device -> server: start a battle against something in the world. The server checks the
-- target exists, is close enough and is free; the device never names a creature or a level.
event StartBattle {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Kind: BattleKind,
		-- A wild creature's id from WildSpawns; 0 for a tamer or the rival.
		TargetId: u32,
		-- A tamer's id or a story battle's id; absent for a wild creature.
		TargetName: string(1..40)?,
	},
}

-- Server -> device: the battle has begun.
event BattleStarted {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Kind: BattleKind,
		Yours: BattleCreature[1..6],
		Theirs: BattleCreature[1..6],
		-- Exact damage each of your active creature's moves would do now (no dice in ranked).
		Previews: u16[0..4],
	},
}

-- Device -> server: the one choice for this turn. Index is the move number (1..4) or the
-- team position to switch to (1..6). Turn must match the server's turn or it is ignored.
event BattleAction {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Turn: u16,
		Kind: ActionKind,
		Index: u8(0..6),
	},
}

-- Server -> device: everything that happened in the turn, and the state to show afterwards.
event BattleTurn {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Turn: u16,
		Events: BattleEvent[0..12],
		YourActive: u8(1..6),
		TheirActive: u8(1..6),
		-- Tempo meters, 0..100.
		YourTempo: u8(0..100),
		TheirTempo: u8(0..100),
		Previews: u16[0..4],
		Finished: boolean,
		-- 0 while the battle goes on or for a draw; 1 if you won; 2 if you lost.
		Outcome: u8(0..2),
	},
}

-- Server -> device: a request was refused, with a short reason the screen can show.
event BattleRefused {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Reason: string(1..80),
	},
}

-- Catching (approval pack 2 section 3). The device asks to throw; the server checks, takes the
-- lasso and sends the sweep; the device sends one tap per zone; the server judges on its own
-- clock and answers with the result and the turn that followed.

enum LassoTier = { Basic, Braided, Gilded }
enum ThrowOutcome = { Caught, Missed, Fled }

-- Server -> device, and back: the server's own round-trip measurement. The nonce is random,
-- so a reply cannot be sent before the ping arrives; a slow reply only makes the reading worse.
event Ping {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { Nonce: u32 },
}
event Pong {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { Nonce: u32 },
}

-- Device -> server: throw this lasso in this battle's current turn.
event ThrowLasso {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Turn: u16,
		Tier: LassoTier,
	},
}

struct LassoZone {
	Centre: f32,
	Width: f32,
	Speed: f32,
	StartPhase: f32,
	StartMs: u16,
}

-- Server -> device: the sweep to play. Times are from when the device receives it.
event LassoPattern {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		ThrowId: u32,
		Zones: LassoZone[1..6],
		SlowMode: boolean,
		ConnectionAssist: boolean,
	},
}

-- Device -> server: one tap, for zone `Zone`, at `ClaimMs` since the sweep began on the device.
-- The server stamps its own arrival time on every tap; the claim is only believed inside the
-- lag window.
event LassoTap {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		ThrowId: u32,
		Zone: u8(1..6),
		ClaimMs: f32,
	},
}

-- Server -> device: how the throw went. A BattleTurn with the turn that followed is sent next.
event LassoResult {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		ThrowId: u32,
		Outcome: ThrowOutcome,
		ZonesHit: u8(0..6),
		Candy: u16,
		Element: Element?,
	},
}

-- Breeding (approval pack 3). The device names two of its creatures, and optionally a Bond Charm
-- slot and the parent it favours; the server checks and decides everything else.
enum Slot = { Head, Torso, FrontLimbs, Legs, Tail }
enum Parent = { A, B }

event RequestBreed {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		ParentA: string(1..40),
		ParentB: string(1..40),
		CharmSlot: Slot?,
		CharmFavour: Parent?,
	},
}

-- Server -> device: the breed's result. HatchAt is the server's Unix time when the egg hatches.
event BreedResult {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Ok: boolean,
		Reason: string(0..80),
		HatchAt: f64,
	},
}

-- Server -> device: eggs that hatched into the stable, by creature id.
event Hatched {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { Ids: string(1..40)[1..8] },
}

-- Server -> device: what a won battle paid, after its last BattleTurn.
struct MemberReward {
	Id: string(1..40),
	Gained: u32,
	Level: u8,
	LevelsGained: u8,
	NewMoves: string(1..24)[0..8],
}
event BattleRewards {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Coins: u32,
		Material: string(0..24),
		Members: MemberReward[0..6],
	},
}

-- Story (approval pack 2: one-time gifts). The device says which beat it reached and, for the
-- first beat, which starter it picked; the server checks the beat is next and its trigger is met.
event CompleteBeat {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BeatId: string(1..40),
		Choice: string(1..24)?,
	},
}

struct GiftView {
	Kind: string(1..16),
	Detail: string(0..40),
	Waiting: boolean,
}

event BeatCompleted {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BeatId: string(1..40),
		Gifts: GiftView[0..12],
		Unlocks: string(1..40)[0..8],
	},
}

-- Releasing a creature back to the wild (approval pack 2): pays a few coins, maybe a material,
-- and typed candy, always less than catching it. Giants and a team's last creature cannot go.
event ReleaseCreature {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { Id: string(1..40) },
}
event ReleaseResult {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Id: string(1..40),
		Ok: boolean,
		Reason: string(0..80),
		Coins: u32,
		Candy: f32,
		Element: Element?,
	},
}

-- Server -> device: the player's saved state, for the screens. Sent once data loads and again
-- after anything changes it (at most a few times a second). Display only: the device never
-- sends any of it back. An egg's child is kept secret until it hatches.
struct PartView {
	Species: string(1..24),
	Quality: u8,
}
struct CreatureView {
	Id: string(1..40),
	BodyPlan: BodyPlan,
	Head: PartView,
	Torso: PartView,
	FrontLimbs: PartView,
	Legs: PartView,
	Tail: PartView,
	Colour: string(1..24),
	CarriedColour: string(1..24),
	Size: f32,
	Rarity: Rarity,
	Level: u8,
	Xp: u32,
	Generation: u16,
	BreedCount: u16,
	BreedReadyAt: f64,
	OriginBiome: u8,
	IsGiant: boolean,
	Bound: boolean,
	Serial: u32?,
}
struct EggView {
	HatchAt: f64,
}
struct CandyView {
	Leaf: f32,
	Sand: f32,
	Water: f32,
	Toxic: f32,
	Frost: f32,
	Crystal: f32,
	Fire: f32,
	Storm: f32,
	Arcane: f32,
	Cosmic: f32,
	Prism: f32,
}
event PlayerState {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Coins: u32,
		Gems: u32,
		Candy: CandyView,
		Items: map { [string(1..24)]: u16 },
		Creatures: CreatureView[0..400],
		Team: string(1..40)[0..6],
		Eggs: EggView[0..4],
		Pens: u8,
		StableCapacity: u16,
		Badges: u8,
		Starter: string(0..24),
		Flags: string(1..40)[0..200],
		-- Quests taken (id -> progress so far) and quests handed in.
		QuestsActive: map { [string(1..40)]: u16 },
		QuestsDone: string(1..40)[0..200],
		Waiting: u8,
	},
}

-- The world. Each player has their own wild creatures: the server tells the device where they
-- are, and the device asks to battle one by its id. The server checks the id is in that
-- player's list and that their character is standing next to it.
struct WildView {
	Id: u32,
	X: f32,
	Z: f32,
	BodyPlan: BodyPlan,
	Head: string(1..24),
	Torso: string(1..24),
	FrontLimbs: string(1..24),
	Legs: string(1..24),
	Tail: string(1..24),
	Colour: string(1..24),
	Size: f32,
	Rarity: Rarity,
	Level: u8,
}
event WildSpawns {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { Spawns: WildView[0..32] },
}

-- Device -> server: the player stepped into a rustle spot.
event Rustle {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { SpotId: string(1..40) },
}

-- Quests. The device names a quest; the server checks it is open to the player and that their
-- character is standing at the quest giver's place. Progress is counted only from things the
-- server itself judged.
event AcceptQuest {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { QuestId: string(1..40) },
}
event HandInQuest {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct { QuestId: string(1..40) },
}
-- Server -> device: a quest was taken, moved on, or handed in (with what it paid).
enum QuestChange = { Taken, Progress, Ready, Done }
event QuestUpdate {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		QuestId: string(1..40),
		Change: QuestChange,
		Progress: u16,
		Needed: u16,
		Gifts: GiftView[0..12],
	},
}

-- Items. Using a tonic or a Rally Root in a battle spends the turn. Buying happens at a shop:
-- the server checks the player is standing there, the price and the coins.
enum FieldItem = { Tonic, GreatTonic, Revive }
event UseItem {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		BattleId: u32,
		Turn: u16,
		Item: FieldItem,
		Target: u8(1..6),
	},
}
event BuyItem {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Item: string(1..24),
		Count: u8(1..99),
	},
}
event BuyResult {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Item: string(1..24),
		Ok: boolean,
		Reason: string(0..80),
		Count: u8,
		Coins: u32,
	},
}
